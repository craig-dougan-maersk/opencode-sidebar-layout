{
  "name": "opencode-sidebar-layout",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist"
  ],
  "overrides": {
    "seroval": "1.6.8"
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='scripts/build.mjs' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test test/*.test.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@npmcli/arborist": "9.9.1",
    "@types/node": "26.6.5",
    "babel-preset-solid": "1.9.12",
    "pacote": "21.5.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
